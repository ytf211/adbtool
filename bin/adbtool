#!/usr/bin/env bash
# Host-side wrapper that forwards adbtool arguments to the Android device.
set -euo pipefail

ADB="${ADB:-adb}"
SERIAL="${ADBTOOL_SERIAL:-}"
REMOTE_JAR="/data/local/tmp/adbtool.jar"

is_connected() {
  local device state rest
  while read -r device state rest; do
    if [[ "$device" == "$SERIAL" && "$state" == "device" ]]; then
      return 0
    fi
  done < <("$ADB" devices)
  return 1
}

if [[ -n "$SERIAL" && "$SERIAL" == *:* ]] && ! is_connected; then
  "$ADB" connect "$SERIAL" >/dev/null
fi

quote_remote_argument() {
  local value="$1"
  value=${value//\'/\'\\\'\'}
  printf -v REPLY "'%s'" "$value"
}

remote="CLASSPATH=$REMOTE_JAR app_process /system/bin com.adbtool.AdbTool"
for argument in "$@"; do
  quote_remote_argument "$argument"
  remote+=" $REPLY"
done

if [[ -n "$SERIAL" ]]; then
  exec "$ADB" -s "$SERIAL" shell "$remote"
else
  exec "$ADB" shell "$remote"
fi
